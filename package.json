{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "TACO ERP API (NestJS, in-memory first)",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "db:check": "ts-node scripts/db-check.ts",
    "db:smoke:schedule-requests": "ts-node scripts/schedule-requests-db-smoke.ts",
    "db:smoke:calendar-assets": "ts-node scripts/calendar-assets-db-smoke.ts",
    "db:smoke:audit-log": "ts-node scripts/audit-log-db-smoke.ts",
    "db:smoke:attendance-reports": "ts-node scripts/attendance-reports-db-smoke.ts",
    "db:smoke:schedule-approval": "ts-node scripts/schedule-approval-db-smoke.ts",
    "db:smoke:finance": "ts-node scripts/finance-db-smoke.ts",
    "db:cleanup:qa": "ts-node scripts/cleanup-qa-data.ts",
    "db:reset:demo": "ts-node scripts/reset-demo-data.ts",
    "db:seed:calendar-demo": "ts-node scripts/seed-calendar-demo.ts",
    "db:bootstrap:ceo": "ts-node scripts/bootstrap-ceo.ts",
    "db:smoke:credentials": "ts-node scripts/credential-change-db-smoke.ts",
    "db:smoke:profile-changes": "ts-node scripts/profile-change-db-smoke.ts",
    "db:migrate:tbo29-auth": "ts-node scripts/migrate-tbo29-auth.ts",
    "db:migrate:profile-changes": "ts-node scripts/migrate-profile-change-requests.ts",
    "openapi": "nest build -p tsconfig.build.json && node dist/scripts/generate-openapi.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:e2e:db-crud": "RUN_DB_CRUD_E2E=1 jest --config test/jest-e2e.json --runInBand test/db-crud.e2e-spec.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "db:migrate:profile-verifications": "ts-node scripts/migrate-profile-verification-challenges.ts",
    "db:migrate:class-session-series": "ts-node scripts/migrate-class-session-series.ts",
    "db:migrate:credential-recovery": "ts-node scripts/migrate-credential-recovery.ts",
    "db:migrate:sens-provider": "ts-node scripts/migrate-sens-provider.ts",
    "db:migrate:parents": "ts-node scripts/migrate-parents.ts",
    "db:migrate:academy-events": "ts-node scripts/migrate-academy-events.ts",
    "db:migrate:countries": "ts-node scripts/migrate-countries.ts",
    "db:migrate:signup-profile-fields": "ts-node scripts/migrate-signup-profile-fields.ts",
    "db:migrate:profile-self-decision": "ts-node scripts/migrate-profile-self-decision.ts",
    "db:migrate:webid-approval": "ts-node scripts/migrate-webid-approval.ts",
    "db:migrate:credential-otp": "ts-node scripts/migrate-credential-otp.ts",
    "db:migrate:counsel-persistence": "ts-node scripts/migrate-counsel-persistence.ts",
    "db:migrate:auth-rate-limits": "ts-node scripts/migrate-auth-rate-limits.ts",
    "db:migrate:remaining-persistence": "ts-node scripts/migrate-remaining-persistence.ts",
    "db:migrate:counsel-form-inputs": "ts-node scripts/migrate-counsel-form-inputs.ts",
    "db:migrate:counsel-round-snapshots": "ts-node scripts/migrate-counsel-round-snapshots.ts",
    "db:migrate:student-profile": "ts-node scripts/migrate-student-profile.ts",
    "db:migrate:staff-pay-calendar": "ts-node scripts/migrate-staff-pay-calendar.ts",
    "db:migrate:student-required-contract": "ts-node scripts/migrate-student-required-contract.ts",
    "db:migrate:course-pay-ssot": "ts-node scripts/migrate-course-pay-ssot.ts",
    "db:migrate:counsel-family-academic-expand": "ts-node scripts/migrate-counsel-family-academic-expand.ts",
    "db:check:counsel-family-academic-contract": "ts-node scripts/check-counsel-family-academic-contract.ts",
    "db:cleanup:demo-data": "ts-node scripts/cleanup-demo-data.ts",
    "db:repair:legacy-unverified-users": "ts-node scripts/repair-legacy-unverified-users.ts",
    "route-coverage": "node dist/scripts/e2e-route-coverage.js",
    "e2e:coverage": "E2E_ROUTE_LOG=/tmp/e2e-routes.log jest --config test/jest-e2e.json --runInBand && npm run route-coverage -- /tmp/e2e-routes.log",
    "db:integrity": "ts-node scripts/db-integrity-check.ts",
    "db:verify-persistence-docs": "ts-node scripts/verify-persistence-docs.ts",
    "db:verify-migrations": "ts-node scripts/verify-migration-ledger.ts"
  },
  "dependencies": {
    "@kms545487/contracts": "^0.2.10",
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.8",
    "nodemailer": "^9.0.1",
    "openapi": "^1.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vercel/node": "^5.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.1.0"
    },
    "multer": "^2.2.0"
  }
}
