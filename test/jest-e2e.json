{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 20000,
  "setupFiles": [
    "<rootDir>/jest-e2e.setup.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "setupFilesAfterEnv": [
    "<rootDir>/jest-e2e.after.ts"
  ]
}
