# backend 환경변수 예시 — 복사해서 사용: cp .env.example .env
# (.env 는 커밋되지 않음)

# API 포트
PORT=3001

# CORS 허용 출처(프론트 브라우저 주소).
# - 로컬: http://localhost:3000
# - Vercel 배포: 프론트 공개 도메인(예: https://taco-frontend-...vercel.app)
# 현재 백엔드 배포: https://taco-backend-omega.vercel.app  · 전체 URL: docs/URLS.md
WEB_ORIGIN=http://localhost:3000

# JWT 서명 비밀키 — 운영에서는 반드시 강한 값으로 교체
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h
