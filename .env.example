# backend 환경변수 예시 — 복사해서 사용: cp .env.example .env
# (.env 는 커밋되지 않음)

# API 포트
PORT=3001

# CORS 허용 출처(프론트 브라우저 주소).
# - 로컬: http://localhost:3000
# - AWS 배포 후: https://your-domain  (또는 프론트 호스팅 주소)
WEB_ORIGIN=http://localhost:3000

# JWT 서명 비밀키 — 운영에서는 반드시 강한 값으로 교체
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h
